VITE_FIREBASE_PROJECT_ID="gothic-flare-j6shk"
VITE_FIREBASE_DATABASE_ID="ai-studio-grow-f1556d5b-af8d-48b4-80a4-0db6695697aa"
VITE_FIREBASE_API_KEY="AIzaSyCNN-9_XuCvMY1smbYSg6_yAmkHZkZ8gBs"
