{
  "entities": {
    "Pole": {
      "title": "Pole",
      "description": "Distribusi tiang listrik PLN ULP Baguala beserta status ROW dan koordinat GIS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "locationName": { "type": "string" },
        "feeder": { "type": "string" },
        "clearanceDistanceMeters": { "type": "number" },
        "clearanceStatus": { "type": "string", "enum": ["Aman", "Waspada", "Kritis", "Bahaya Kritis"] },
        "vegetationType": { "type": "string" },
        "poleType": { "type": "string" },
        "statusKondisi": { "type": "string" },
        "lastInspected": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "code", "latitude", "longitude", "feeder", "clearanceDistanceMeters", "clearanceStatus"]
    },
    "CableSpan": {
      "title": "CableSpan",
      "description": "Bentangan kabel antar tiang listrik pada jaringan distribusi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromPoleId": { "type": "string" },
        "toPoleId": { "type": "string" },
        "feeder": { "type": "string" },
        "cableType": { "type": "string" },
        "lengthMeters": { "type": "number" },
        "clearanceStatus": { "type": "string" },
        "color": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "fromPoleId", "toPoleId", "feeder"]
    },
    "MaintenanceWorkOrder": {
      "title": "MaintenanceWorkOrder",
      "description": "Surat Perintah Kerja (SPK) rabas pohon dan pemeliharaan ROW",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "spkNumber": { "type": "string" },
        "poleId": { "type": "string" },
        "locationName": { "type": "string" },
        "issueType": { "type": "string" },
        "priority": { "type": "string", "enum": ["Rendah", "Sedang", "Tinggi", "Kritis"] },
        "assignedTeam": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Menunggu", "Disetujui", "Dikerjakan", "Selesai", "Dibatalkan"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "spkNumber", "poleId", "issueType", "priority", "status"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Akun personel dan administrator sistem GROW ULP Baguala",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "password": { "type": "string" },
        "unit": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "userId", "name", "role", "unit"]
    },
    "SystemMeta": {
      "title": "SystemMeta",
      "description": "Metadata sinkronisasi dua arah real-time antara AI Studio dan Vercel",
      "type": "object",
      "properties": {
        "masterName": { "type": "string" },
        "lastSyncTime": { "type": "string" },
        "lastSource": { "type": "string" },
        "polesCount": { "type": "number" },
        "spansCount": { "type": "number" },
        "feederColors": { "type": "object" }
      },
      "required": ["lastSyncTime"]
    }
  },
  "firestore": {
    "/poles/{poleId}": {
      "schema": "Pole",
      "description": "Koleksi data tiang distribusi GIS ULP Baguala"
    },
    "/spans/{spanId}": {
      "schema": "CableSpan",
      "description": "Koleksi data bentangan kabel distribusi"
    },
    "/spks/{spkId}": {
      "schema": "MaintenanceWorkOrder",
      "description": "Koleksi Surat Perintah Kerja (SPK)"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Koleksi akun pengguna GROW"
    },
    "/system_meta/{metaId}": {
      "schema": "SystemMeta",
      "description": "Metadata sistem sinkronisasi real-time"
    }
  }
}
