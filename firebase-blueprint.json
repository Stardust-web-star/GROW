{
  "entities": {
    "Pole": {
      "title": "Pole",
      "description": "PLN distribution pole data including physical condition, coordinates, and vegetation clearance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Unique Pole ID" },
        "code": { "type": "string", "maxLength": 128, "description": "PLN pole asset code" },
        "feeder": { "type": "string", "maxLength": 128, "description": "Feeder line name" },
        "type": { "type": "string", "enum": ["TM", "TR", "Gardu Trafo", "TT"], "description": "Pole voltage type" },
        "lat": { "type": "number", "description": "Latitude coordinate" },
        "lng": { "type": "number", "description": "Longitude coordinate" },
        "locationName": { "type": "string", "maxLength": 256, "description": "Pole location description" },
        "material": { "type": "string", "enum": ["Beton", "Besi"], "description": "Pole material" },
        "heightMeters": { "type": "number", "description": "Pole height in meters" },
        "physicalCondition": { "type": "string", "enum": ["Baik", "Perlu Perbaikan", "Miring / Retak", "Korosi Kritis"], "description": "Pole physical condition" },
        "installationYear": { "type": "number", "description": "Installation year" },
        "lastInspectionDate": { "type": "string", "maxLength": 64, "description": "Last inspection date string" },
        "clearanceDistanceMeters": { "type": "number", "description": "Clearance distance in meters" },
        "clearanceStatus": { "type": "string", "maxLength": 128, "description": "ROW status" },
        "clearanceObject": { "type": "string", "maxLength": 128, "description": "Object near the line" },
        "spkStatus": { "type": "string", "enum": ["Belum SPK", "SPK Diterbitkan", "Selesai Dikerjakan"], "description": "Work order status" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Additional notes" },
        "photoUrl": { "type": "string", "maxLength": 2048, "description": "Photo URL" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Last updated timestamp" }
      },
      "required": ["id", "code", "feeder", "lat", "lng"]
    },
    "CableSpan": {
      "title": "CableSpan",
      "description": "Cable span connection between two poles with clearance and physical condition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Unique Cable Span ID" },
        "fromPoleId": { "type": "string", "maxLength": 128, "description": "Source pole ID" },
        "toPoleId": { "type": "string", "maxLength": 128, "description": "Target pole ID" },
        "conductorType": { "type": "string", "maxLength": 128, "description": "Cable conductor type" },
        "lengthMeters": { "type": "number", "description": "Span length in meters" },
        "clearanceMeters": { "type": "number", "description": "Clearance in meters" },
        "hasViolation": { "type": "boolean", "description": "Whether span violates ROW" },
        "violationType": { "type": "string", "maxLength": 128, "description": "ROW violation classification" },
        "feeder": { "type": "string", "maxLength": 128, "description": "Feeder name" },
        "cableCondition": { "type": "string", "maxLength": 128, "description": "Physical condition of cable" },
        "treeDistanceMeters": { "type": "number", "description": "Distance to vegetation in meters" },
        "buildingDistanceMeters": { "type": "number", "description": "Distance to structure in meters" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Field notes" },
        "photoUrl": { "type": "string", "maxLength": 2048, "description": "Photo URL" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Last updated timestamp" }
      },
      "required": ["id", "fromPoleId", "toPoleId"]
    },
    "MaintenanceWorkOrder": {
      "title": "MaintenanceWorkOrder",
      "description": "PLN maintenance work order (SPK)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "SPK ID" },
        "spkNumber": { "type": "string", "maxLength": 128, "description": "Official SPK number" },
        "poleId": { "type": "string", "maxLength": 128, "description": "Target pole ID" },
        "locationName": { "type": "string", "maxLength": 256, "description": "Work site location" },
        "issueType": { "type": "string", "maxLength": 128, "description": "Maintenance issue" },
        "priority": { "type": "string", "enum": ["Kritis", "Tinggi", "Sedang", "Rutin"], "description": "Priority level" },
        "assignedTeam": { "type": "string", "maxLength": 128, "description": "Assigned field unit team" },
        "scheduledDate": { "type": "string", "maxLength": 64, "description": "Execution schedule date" },
        "status": { "type": "string", "enum": ["Draf", "Disetujui", "Dalam Pengerjaan", "Selesai"], "description": "Work order progress" },
        "aiRecommendation": { "type": "string", "maxLength": 1000, "description": "AI recommendation summary" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation date" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Last updated timestamp" }
      },
      "required": ["id", "spkNumber", "poleId", "status"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "PLN GROW user account profile and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "User document ID" },
        "userId": { "type": "string", "maxLength": 64, "description": "PLN User ID e.g. 9925045ZY" },
        "name": { "type": "string", "maxLength": 128, "description": "Full name" },
        "role": { "type": "string", "enum": ["Administrator", "Supervisor Teknik", "Petugas Yantek", "Operator GIS"], "description": "Application role" },
        "unit": { "type": "string", "maxLength": 128, "description": "PLN work unit" },
        "email": { "type": "string", "maxLength": 128, "description": "Contact email" },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif"], "description": "Account status" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Creation date" },
        "lastLogin": { "type": "string", "maxLength": 64, "description": "Last login date" }
      },
      "required": ["id", "userId", "name", "role", "status"]
    },
    "AppState": {
      "title": "AppState",
      "description": "Global application sync state and deleted IDs tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "description": "Document ID" },
        "masterName": { "type": "string", "maxLength": 128, "description": "Master dataset name" },
        "lastUpdated": { "type": "string", "maxLength": 64, "description": "Last synchronization timestamp" },
        "deletedPoleIds": { "type": "array", "description": "List of deleted pole IDs" },
        "deletedSpanIds": { "type": "array", "description": "List of deleted span IDs" },
        "feederColors": { "type": "string", "maxLength": 5000, "description": "JSON stringified feeder color map" }
      },
      "required": ["id", "lastUpdated"]
    }
  },
  "firestore": {
    "/poles/{poleId}": {
      "schema": "Pole",
      "description": "Live synchronized PLN poles collection"
    },
    "/spans/{spanId}": {
      "schema": "CableSpan",
      "description": "Live synchronized cable spans collection"
    },
    "/spks/{spkId}": {
      "schema": "MaintenanceWorkOrder",
      "description": "PLN maintenance work orders collection"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "PLN user accounts"
    },
    "/app_state/{stateId}": {
      "schema": "AppState",
      "description": "Global synchronization metadata and deletion ledger"
    }
  }
}
