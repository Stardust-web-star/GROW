rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened ID validation guard
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }

    // Validation for Poles
    function isValidPole(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 128 &&
             data.feeder is string && data.feeder.size() <= 128 &&
             data.lat is number && data.lat >= -90.0 && data.lat <= 90.0 &&
             data.lng is number && data.lng >= -180.0 && data.lng <= 180.0 &&
             (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 256)) &&
             (!('material' in data) || (data.material is string && data.material.size() <= 32)) &&
             (!('physicalCondition' in data) || (data.physicalCondition is string && data.physicalCondition.size() <= 64)) &&
             (!('clearanceDistanceMeters' in data) || (data.clearanceDistanceMeters is number)) &&
             (!('clearanceStatus' in data) || (data.clearanceStatus is string && data.clearanceStatus.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000));
    }

    match /poles/{poleId} {
      allow read: if true;
      allow create: if isValidId(poleId) && isValidPole(incoming());
      allow update: if isValidId(poleId) && isValidPole(incoming());
      allow delete: if isValidId(poleId);
    }

    // Validation for Cable Spans
    function isValidCableSpan(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fromPoleId is string && data.fromPoleId.size() <= 128 &&
             data.toPoleId is string && data.toPoleId.size() <= 128 &&
             (!('conductorType' in data) || (data.conductorType is string && data.conductorType.size() <= 128)) &&
             (!('lengthMeters' in data) || (data.lengthMeters is number)) &&
             (!('clearanceMeters' in data) || (data.clearanceMeters is number)) &&
             (!('hasViolation' in data) || (data.hasViolation is bool)) &&
             (!('cableCondition' in data) || (data.cableCondition is string && data.cableCondition.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000));
    }

    match /spans/{spanId} {
      allow read: if true;
      allow create: if isValidId(spanId) && isValidCableSpan(incoming());
      allow update: if isValidId(spanId) && isValidCableSpan(incoming());
      allow delete: if isValidId(spanId);
    }

    // Validation for Maintenance Work Orders (SPK)
    function isValidSpk(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.spkNumber is string && data.spkNumber.size() <= 128 &&
             data.poleId is string && data.poleId.size() <= 128 &&
             data.status is string && data.status.size() <= 64 &&
             (!('issueType' in data) || (data.issueType is string && data.issueType.size() <= 128)) &&
             (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 256)) &&
             (!('priority' in data) || (data.priority is string && data.priority.size() <= 64)) &&
             (!('assignedTeam' in data) || (data.assignedTeam is string && data.assignedTeam.size() <= 128)) &&
             (!('aiRecommendation' in data) || (data.aiRecommendation is string && data.aiRecommendation.size() <= 2048));
    }

    match /spks/{spkId} {
      allow read: if true;
      allow create: if isValidId(spkId) && isValidSpk(incoming());
      allow update: if isValidId(spkId) && isValidSpk(incoming());
      allow delete: if isValidId(spkId);
    }

    // Validation for Users
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             data.role is string && data.role.size() <= 64 &&
             data.status is string && data.status.size() <= 32 &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 128));
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Validation for App State & Deletion Tracker
    function isValidAppState(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.lastUpdated is string && data.lastUpdated.size() <= 64 &&
             (!('masterName' in data) || (data.masterName is string && data.masterName.size() <= 128)) &&
             (!('feederColors' in data) || (data.feederColors is string && data.feederColors.size() <= 10000));
    }

    match /app_state/{stateId} {
      allow read: if true;
      allow create: if isValidId(stateId) && isValidAppState(incoming());
      allow update: if isValidId(stateId) && isValidAppState(incoming());
      allow delete: if isValidId(stateId);
    }
  }
}
