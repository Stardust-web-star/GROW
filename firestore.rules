rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tiang GIS PLN ULP Baguala
    match /poles/{poleId} {
      allow read, write: if true;
    }

    // Bentangan Kabel Distribusi
    match /spans/{spanId} {
      allow read, write: if true;
    }

    // Surat Perintah Kerja (SPK) Pemeliharaan ROW
    match /spks/{spkId} {
      allow read, write: if true;
    }

    // Akun Pengguna GROW
    match /users/{userId} {
      allow read, write: if true;
    }

    // Metadata Sinkronisasi Real-Time Dua Arah (Google AI Studio <-> Vercel)
    match /system_meta/{metaId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
